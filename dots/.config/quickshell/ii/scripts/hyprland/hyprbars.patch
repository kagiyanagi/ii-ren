+// ii-ren: the shell's icons, stroked rather than set as text, so that each sits exactly in the
+// middle of its button: a chevron down (minimize), a diamond (maximize), a cross (close).
+// Strokes 1.5px, round caps, on a glyph 3/8 of the button, as the apps with their own
+// buttons draw them.
+SP<Render::ITexture> CHyprBar::strokeIcon(const std::string& icon, const CHyprColor& col, double size, float scale) {
+    const int  S  = std::max(1, (int)std::round(size));
+    const auto CS = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, S, S);
+    const auto CR = cairo_create(CS);
+    const auto C = S / 2.0, G = S * 0.375 / 2.0;
+
+    cairo_set_source_rgba(CR, col.r, col.g, col.b, col.a);
+    cairo_set_line_width(CR, 1.5 * scale);
+    cairo_set_line_cap(CR, CAIRO_LINE_CAP_ROUND);
+    cairo_set_line_join(CR, CAIRO_LINE_JOIN_ROUND);
+    if (icon == "ii:minimize") {
+        cairo_move_to(CR, C - G, C - G / 2);
+        cairo_line_to(CR, C, C + G / 2);
+        cairo_line_to(CR, C + G, C - G / 2);
+    } else if (icon == "ii:maximize") {
+        cairo_move_to(CR, C, C - G);
+        cairo_line_to(CR, C + G, C);
+        cairo_line_to(CR, C, C + G);
+        cairo_line_to(CR, C - G, C);
+        cairo_close_path(CR);
+    } else {
+        const auto X = G * 0.85;
+        cairo_move_to(CR, C - X, C - X);
+        cairo_line_to(CR, C + X, C + X);
+        cairo_move_to(CR, C + X, C - X);
+        cairo_line_to(CR, C - X, C + X);
+    }
+    cairo_stroke(CR);
+    cairo_surface_flush(CS);
+
+    auto tex = g_pHyprRenderer->createTexture(CS);
+    cairo_destroy(CR);
+    cairo_surface_destroy(CS);
+    return tex;
+}
